{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "files": [
    "src/index.ts",
    "src/helpers.ts",
    "src/ssg/client.tsx",
    "src/ssg/router/index.ts",
    "src/ssg/server/render.ts",
    "src/ssg/vite/index.ts",
    "src/ssg/vite/config.ts",
    "src/ssg/vite/virtual.d.ts"
  ]
}
