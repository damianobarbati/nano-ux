{
  "name": "nano-ux",
  "version": "0.0.22",
  "license": "MIT",
  "description": "Nano sized UI kit.",
  "author": "Damiano Barbati <damiano.barbati@gmail.com> (https://github.com/damianobarbati)",
  "repository": "https://github.com/damianobarbati/nano-ux",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js"
    },
    "./theme.css": "./dist/theme.css",
    "./theme": "./dist/components/theme.js",
    "./tailwind.css": "./dist/style/theme.css",
    "./charts/bar": {
      "types": "./dist/components/ChartBar.d.ts",
      "import": "./dist/components/ChartBar.js"
    },
    "./charts/line": {
      "types": "./dist/components/ChartLine.d.ts",
      "import": "./dist/components/ChartLine.js"
    },
    "./charts/world-map": {
      "types": "./dist/components/WorldMap.d.ts",
      "import": "./dist/components/WorldMap.js"
    },
    "./ssg": {
      "types": "./dist/ssg/vite/public.d.ts",
      "import": "./dist/ssg/vite/index.js"
    },
    "./ssg/config": {
      "types": "./dist/ssg/vite/config.d.ts",
      "import": "./dist/ssg/vite/config.js"
    },
    "./ssg/excerpts": {
      "types": "./dist/ssg/server/excerpts.d.ts",
      "import": "./dist/ssg/server/excerpts.js"
    },
    "./ssg/types": {
      "types": "./dist/ssg/vite/virtual.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc && tailwindcss -i src/style/theme.css -o dist/theme.css --minify && cp -R src/style/. dist/style/ && cp src/ssg/vite/*.d.ts src/ssg/vite/template.html dist/ssg/vite/ && cp src/ssg/README.md dist/ssg/",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "prepack": "pnpm run build && cp ../../README.md README.md",
    "test:ssg": "node --test src/ssg/vite/index.test.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "clsx-tw": "^1.0.9",
    "echarts": "^6.1.0",
    "prismjs": "^1.30.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "rollup-plugin-visualizer": "^7.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-compression2": "^2.5.4"
  },
  "peerDependencies": {
    "@babel/core": "^8.1.3",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "rollup-plugin-visualizer": "^7.3.0",
    "swr": "^2.4.1",
    "vite": "^8.3.8",
    "vite-plugin-compression2": "^2.5.4"
  },
  "homepage": "https://damianobarbati.github.io/nano-ux/",
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@rolldown/plugin-babel": {
      "optional": true
    },
    "@babel/core": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "babel-plugin-react-compiler": {
      "optional": true
    },
    "rollup-plugin-visualizer": {
      "optional": true
    },
    "vite-plugin-compression2": {
      "optional": true
    }
  }
}
