{
  "name": "nano-ux-monorepo",
  "version": "0.0.31",
  "private": true,
  "type": "module",
  "repository": "https://github.com/damianobarbati/nano-ux",
  "homepage": "https://damianobarbati.github.io/nano-ux/",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "pnpm -F nano-ux run build && pnpm -F website run build",
    "lint": "oxlint --fix && biome check --write --unsafe && tsc --noEmit",
    "test": "pnpm -F nano-ux run build && pnpm -F website run test",
    "release": "pnpm -F nano-ux publish --no-git-checks",
    "predev": "for port in 9000 9001; do lsof -nP -tiTCP:$port -sTCP:LISTEN | while read -r pid; do kill \"$pid\"; done; done",
    "dev": "pnpm -r --parallel dev",
    "bump": "pnpm -r --include-workspace-root version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "oxlint": "^1.95.0",
    "oxlint-better": "^1.0.8",
    "typescript": "~7.0.2"
  }
}
